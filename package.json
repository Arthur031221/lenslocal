    "test:watch": "vitest",
    "lint": "eslint src tests eval",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  }
